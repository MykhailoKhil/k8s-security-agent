# Copy to .env, fill in, then: set -a; . ./.env; set +a
# (Also works with: docker run --env-file .env ... so comments live on their own lines.)

# Required in the container / Helm. Locally, the Claude Code login is used if this is empty.
ANTHROPIC_API_KEY=

# Comma list of kubeconfig contexts. Use read-only ones (./auditor-context.sh). Empty = skip clusters.
K8S_CONTEXTS=k3d-workload-auditor,k3d-mgmt-auditor

# Comma list of local dirs with manifests / Kustomize / Helm.
AUDIT_PATHS=/Users/mike/workspace/argocd-lab-gitops,/Users/mike/workspace/argocd-lab-app

# Comma list of https git URLs to shallow-clone and scan, plus a read-only token for private ones.
AUDIT_REPOS=
GIT_TOKEN=

# Where findings.json, report.html, digest.json and raw scanner output land.
OUT_DIR=out

# Drop "vuln" for a faster run (image CVEs are the slowest scan).
TRIVY_SCANNERS=vuln,secret,misconfig

# LLM tuning: effort low|medium|high, optional model override, seconds allowed per scanner.
EFFORT=low
CLAUDE_MODEL=
SCAN_TIMEOUT=900

# Phase 3: verify the top findings with read-only tools (get_manifest, list_network_policies, who_can, get_pod_security_context).
# Needs K8S_CONTEXTS. Set INVESTIGATE=0 to skip. All limits are enforced in code; the cost cap can overshoot by INVESTIGATE_CONCURRENCY x per-finding cap.
INVESTIGATE=1
INVESTIGATE_TOP_N=10
INVESTIGATE_CALLS_PER_FINDING=4
INVESTIGATE_RUN_CALLS=30
INVESTIGATE_BUDGET_USD=1.0
INVESTIGATE_PER_FINDING_USD=0.25
INVESTIGATE_CONCURRENCY=3

# Run history for the New / Fixed / Persisting section lives in OUT_DIR/history (keep OUT_DIR between runs; the Helm chart needs persistence.enabled).
HISTORY_KEEP=30

# Retries for a scanner that fails (network flakes); backoff 5 s, 15 s.
SCAN_RETRIES=2

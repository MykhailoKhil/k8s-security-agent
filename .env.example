# Copy to .env and `set -a; . ./.env; set +a` (or pass with docker --env-file). No CLI flags exist.
ANTHROPIC_API_KEY=            # required
K8S_CONTEXTS=k3d-workload-auditor,k3d-mgmt-auditor   # comma list of kubeconfig contexts (use read-only ones); empty = skip clusters
AUDIT_PATHS=/Users/mike/workspace/argocd-lab-gitops,/Users/mike/workspace/argocd-lab-app   # local manifest/Helm/Kustomize dirs
AUDIT_REPOS=                  # comma list of https git URLs to shallow-clone and scan
GIT_TOKEN=                    # read-only token for private AUDIT_REPOS
OUT_DIR=out                   # findings.json, report.html and raw scanner output land here
MAX_TURNS=80
CLAUDE_MODEL=                 # optional override
TRIVY_SCANNERS=vuln,secret,misconfig   # drop "vuln" for a faster run (image CVEs are the slowest scan)
EFFORT=low                    # LLM effort: low|medium|high
SCAN_TIMEOUT=900              # seconds per scanner

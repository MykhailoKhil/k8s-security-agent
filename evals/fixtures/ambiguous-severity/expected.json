{
 "description": "node-exporter and k3s svclb need host access (expected); a customer-facing pod with host network is the real risk.",
 "targets": [
  "prod"
 ],
 "acceptable": [
  {
   "id": "default-binding",
   "any_of": [
    "system:masters",
    "platform default",
    "platform cluster-admin"
   ]
  },
  {
   "id": "vuln-rollup",
   "any_of": [
    "vulnerabilit",
    "cves"
   ]
  },
  {
   "id": "minor-misconfig",
   "any_of": [
    "misconfiguration",
    "healthcheck",
    "untrusted-registry"
   ]
  }
 ],
 "must_include": [
  {
   "id": "checkout-hostnet",
   "any_of": [
    "checkout"
   ],
   "severity": [
    "HIGH",
    "CRITICAL"
   ]
  }
 ],
 "must_not": [
  {
   "id": "node-exporter-expected",
   "match": [
    "node-exporter"
   ],
   "above": "MEDIUM"
  },
  {
   "id": "svclb-expected",
   "match": [
    "svclb"
   ],
   "above": "MEDIUM"
  }
 ],
 "must_have_not_checked": [
  "node and control-plane"
 ]
}
{
 "description": "Healthy cluster: the report must not overclaim.",
 "targets": [
  "good"
 ],
 "must_include": [],
 "acceptable": [
  {
   "id": "readonly-fs",
   "any_of": [
    "C-0017",
    "KSV-0014",
    "filesystem"
   ]
  },
  {
   "id": "cve",
   "any_of": [
    "vulnerab",
    "cve"
   ]
  },
  {
   "id": "default-binding",
   "any_of": [
    "system:masters",
    "platform default",
    "platform cluster-admin"
   ]
  },
  {
   "id": "vuln-rollup",
   "any_of": [
    "vulnerabilit",
    "cves"
   ]
  },
  {
   "id": "minor-misconfig",
   "any_of": [
    "misconfiguration",
    "healthcheck",
    "untrusted-registry"
   ]
  }
 ],
 "must_not": [
  {
   "id": "default-masters",
   "match": [
    "system:masters"
   ],
   "above": "LOW"
  }
 ],
 "max_severity_overall": "MEDIUM",
 "max_findings": 8,
 "must_have_not_checked": [
  "node and control-plane"
 ]
}
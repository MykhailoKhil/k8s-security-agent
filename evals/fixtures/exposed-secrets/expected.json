{
 "description": "Repo scan finds an AWS key and a private key committed in the working tree.",
 "targets": [
  "payments-gitops"
 ],
 "must_include": [
  {
   "id": "aws-key",
   "any_of": [
    "aws-access-key-id",
    "prod.env"
   ],
   "severity": [
    "HIGH",
    "CRITICAL"
   ]
  },
  {
   "id": "private-key",
   "any_of": [
    "private-key",
    "key.pem"
   ],
   "severity": [
    "HIGH",
    "CRITICAL"
   ]
  }
 ],
 "acceptable": [
  {
   "id": "readonly-fs",
   "any_of": [
    "KSV-0014",
    "read-only",
    "filesystem"
   ]
  },
  {
   "id": "creds",
   "any_of": [
    "C-0012"
   ]
  },
  {
   "id": "default-binding",
   "any_of": [
    "system:masters",
    "platform default",
    "platform cluster-admin"
   ]
  },
  {
   "id": "vuln-rollup",
   "any_of": [
    "vulnerabilit",
    "cves"
   ]
  },
  {
   "id": "minor-misconfig",
   "any_of": [
    "misconfiguration",
    "healthcheck",
    "untrusted-registry"
   ]
  }
 ],
 "must_not": [],
 "must_have_not_checked": [
  "git history"
 ]
}